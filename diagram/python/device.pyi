class Vec3:
    x: float
    y: float
    z: float

class IMUValue:
    acc  : Vec3
    gyro : Vec3

class Servo:
    def __init__(self, channel: int, mode: int) -> None: ...
    def enable(self) -> None: ...
    def disable(self) -> None: ...
    def set_angle(self, angle: float) -> None: ...
    def set_speed(self, speed: float) -> None: ...

class IMU:
    def __init__(self) -> None: ...
    def get_value(self) -> IMUValue: ...

class UltrasonicDistanceSensor:
    def __init__(self) -> None: ...
    def get_distance(self) -> float: ...

# SSD1306 ディスプレイ
class Display:
    def __init__(self) -> None: ...
    def set_text_color(self, color:int) -> None: ...
    def set_cursor(self, x:int, y:int) -> None: ...
    def print(self, text: str) -> None: ...
    def draw_line(self, start_x: int, start_y: int, end_x: int, end_y: int, color: int) -> None: ...
    def draw_rect(self, left: int, top: int, width: int, height: int, color: int) -> None: ...
    def draw_circle(self, center_x: int, center_y: int, radius: int, color: int) -> None: ...
    def fill_circle(self, center_x: int, center_y: int, radius: int, color: int) -> None: ...
    def display(self) -> None: ...

# パソコンのシリアルモニタに出力する。
def print(text: str) -> None: ...

# importなしで使うVMの待機。秒単位で整数・小数を受け付ける。
# sleep(1.0)は約1秒待ち、0秒もESP32のloop()へ一度制御を返す。
# 待機中はPythonだけを中断し、時間経過後は続きから再開する。
# 範囲・丸め・取消とVMとの分担はESP32のdevice_native.cppのfunction_sleepを参照する。
def sleep(seconds: float) -> None: ...
