class Vec3:
    x: float
    y: float
    z: float

class IMUValue:
    acc  : Vec3
    gyro : Vec3

class Servo:
    def __init__(self, channel: int, mode: int) -> None: ...
    def enable(self) -> None: ...
    def disable(self) -> None: ...
    def set_angle(self, angle: float) -> None: ...
    def set_speed(self, speed: float) -> None: ...

class IMU:
    def __init__(self) -> None: ...
    def get_value(self) -> IMUValue: ...

class UltrasonicDistanceSensor:
    def __init__(self) -> None: ...
    def get_distance(self) -> float: ...

# SSD1306 ディスプレイ
class Display:
    def __init__(self) -> None: ...
    def set_text_color(self, color:int) -> None: ...
    def set_cursor(self, x:int, y:int) -> None: ...
    def print(self, text: str) -> None: ...
    def draw_line(self, start_x: int, start_y: int, end_x: int, end_y: int, color: int) -> None: ...
    def draw_rect(self, left: int, top: int, width: int, height: int, color: int) -> None: ...
    def draw_circle(self, center_x: int, center_y: int, radius: int, color: int) -> None: ...
    def fill_circle(self, center_x: int, center_y: int, radius: int, color: int) -> None: ...
    def display(self) -> None: ...

# パソコンのシリアルモニタに出力する。
def print(text: str) -> None: ...

# importなしで使うVMの待機。秒単位で整数・小数を受け付ける。
# sleep(1.0)は約1秒待ち、0秒もESP32のloop()へ一度制御を返す。
# 待機中はPythonだけを中断し、時間経過後は続きから再開する。
# 範囲・丸め・取消とVMとの分担はESP32のdevice_native.cppのfunction_sleepを参照する。
def sleep(seconds: float) -> None: ...

# Pythonプログラム開始からの経過時間を浮動小数点数（秒）で返す。
# importなしで呼び出す。起点・精度・VMとの分担はESP32の
# device_native.cppのfunction_timeの仕様コメントを参照する。
def time() -> float: ...

# 三角関数。引数の角度はラジアン。importなしで呼び出す。
# 精度・不正値の扱いと生成APIとの分担はESP32のdevice_api.generated.cppの
# invokeFloatUnaryの仕様コメントを参照する（生成元: device_api_cpp.py）。
def sin(angle: float) -> float: ...
def cos(angle: float) -> float: ...
def tan(angle: float) -> float: ...

# 数値関数はimportなしで使う。整数引数もfloatへ変換し、結果はfloatで返す。
# 単項関数の仕様は生成C++のinvokeFloatUnary、二項関数はinvokeFloatBinaryを参照する。
# min/maxは数値2引数のみ。floor/ceilの結果もintではなくfloat。
def min(a: float, b: float) -> float: ...
def max(a: float, b: float) -> float: ...
def floor(value: float) -> float: ...
def ceil(value: float) -> float: ...

# modfは小数部だけを入力と同符号で返す（例: -1.25 -> -0.25）。整数部・タプルは返さない。
def modf(value: float) -> float: ...

# acos/asinは[-1, 1]を受け、ラジアンで返す。atan2の引数順はy, x。
def acos(value: float) -> float: ...
def asin(value: float) -> float: ...
def atan2(y: float, x: float) -> float: ...

# 絶対値をfloatで返す。整数引数もfloatへ変換する。仕様は生成C++のinvokeFloatUnaryを参照する。
def abs(value: float) -> float: ...


