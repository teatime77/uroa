{
  "name": "uroa",
  "private": true,
  "type": "module",
  "workspaces": [
    "i18n",
    "parser",
    "algebra",
    "layout",
    "plane",
    "firebase",
    "webgpu",
    "game",
    "diagram"
  ],
  "scripts": {
    "dev": "vite",
    "build:all": "npm run check:rpc && tsc -b tsconfig.sys.json",
    "build": "npm run build:all && vite build",
    "preview": "vite preview",
    "check:dist": "node scripts/check-dist.mjs",
    "verify": "npm run build && npm run check:dist",
    "test:e2e": "python tests/test.py",
    "test:lifecycle": "npm run build:all && node --test tests/lifecycle.test.mjs",
    "test:e2e:lifecycle": "python tests/test_lifecycle.py",
    "install:all": "npm install",
    "generate:rpc": "node diagram/rpc/generate.mjs",
    "check:rpc": "node diagram/rpc/generate.mjs --check"
  },
  "devDependencies": {
    "@types/gl-matrix": "^2.4.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.2.2",
    "@types/plotly.js": "3.0.15",
    "@webgpu/types": "^0.1.69",
    "madge": "^8.0.0",
    "protobufjs": "7.6.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@wasmer/wasi": "0.12.0",
    "@wasmer/wasmfs": "0.12.0",
    "binaryen": "132.0.0",
    "buffer": "6.0.3",
    "fflate": "0.8.3",
    "firebase": "^10.14.1",
    "gl-matrix": "^3.4.4",
    "katex": "^0.18.5",
    "path-browserify": "1.0.1"
  }
}
